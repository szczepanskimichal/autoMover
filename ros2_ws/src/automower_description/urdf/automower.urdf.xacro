<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="automower">

  <!-- Dimensions -->

  <xacro:property name="body_length" value="1.2"/>
  <xacro:property name="body_width"  value="0.8"/>
  <xacro:property name="body_height" value="0.2"/>

  <xacro:property name="wheel_radius" value="0.18"/>
  <xacro:property name="wheel_width"  value="0.12"/>

  <xacro:property name="wheel_x" value="0.45"/>
  <xacro:property name="wheel_y" value="0.48"/>

  <xacro:property name="deck_radius" value="0.33"/>
  <xacro:property name="deck_height" value="0.12"/>
  <xacro:property name="deck_x" value="0.05"/>
  <xacro:property name="deck_z" value="-0.17"/>

  <xacro:property name="blade_radius" value="0.24"/>
  <xacro:property name="blade_width" value="0.05"/>
  <xacro:property name="blade_height" value="0.02"/>

  <xacro:property name="lidar_mount_x" value="0.23"/>
  <xacro:property name="lidar_mount_z" value="0.18"/>
  <xacro:property name="lidar_mast_radius" value="0.03"/>
  <xacro:property name="lidar_mast_height" value="0.16"/>
  <xacro:property name="lidar_radius" value="0.075"/>
  <xacro:property name="lidar_height" value="0.06"/>

  <!-- BASE FOOTPRINT -->

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- Lift the visual body above the ground-aligned footprint frame. -->
    <origin xyz="0 0 0.28" rpy="0 0 0"/>
  </joint>

  <!-- BODY -->

  <link name="base_link">

    <visual>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>

      <material name="green">
        <color rgba="0.1 0.35 0.1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="25.0"/>
      <origin xyz="0 0 0"/>

      <inertia
        ixx="1.4167"
        ixy="0"
        ixz="0"
        iyy="3.0833"
        iyz="0"
        izz="4.3333"/>
    </inertial>

  </link>

  <!-- Wheel macro -->

  <xacro:macro name="wheel" params="name x y">

    <link name="${name}_wheel">

      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>

        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>

        <material name="black">
          <color rgba="0.03 0.03 0.03 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>

        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="2.0"/>
        <origin xyz="0 0 0"/>

        <inertia
          ixx="0.018"
          ixy="0"
          ixz="0"
          iyy="0.0324"
          iyz="0"
          izz="0.018"/>
      </inertial>

    </link>

    <joint name="${name}_wheel_joint" type="continuous">

      <parent link="base_link"/>
      <child link="${name}_wheel"/>

      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

    </joint>

  </xacro:macro>

  <link name="mower_deck_link">
    <visual>
      <geometry>
        <cylinder radius="${deck_radius}" length="${deck_height}"/>
      </geometry>
      <material name="deck_red">
        <color rgba="0.75 0.12 0.10 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="${deck_radius}" length="${deck_height}"/>
      </geometry>
    </collision>
  </link>

  <joint name="mower_deck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mower_deck_link"/>
    <origin xyz="${deck_x} 0 ${deck_z}" rpy="0 0 0"/>
  </joint>

  <link name="blade_link">
    <visual>
      <geometry>
        <box size="${blade_radius * 2.0} ${blade_width} ${blade_height}"/>
      </geometry>
      <material name="blade_silver">
        <color rgba="0.75 0.75 0.78 1"/>
      </material>
    </visual>
  </link>

  <joint name="blade_joint" type="fixed">
    <parent link="mower_deck_link"/>
    <child link="blade_link"/>
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
  </joint>

  <link name="lidar_mast_link">
    <visual>
      <origin xyz="0 0 ${lidar_mast_height * 0.5}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_mast_radius}" length="${lidar_mast_height}"/>
      </geometry>
      <material name="mast_black">
        <color rgba="0.08 0.08 0.08 1"/>
      </material>
    </visual>
  </link>

  <joint name="lidar_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_mast_link"/>
    <origin xyz="${lidar_mount_x} 0 ${lidar_mount_z}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="lidar_gold">
        <color rgba="0.78 0.68 0.22 1"/>
      </material>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_mast_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_mast_height + lidar_height * 0.5}" rpy="1.5708 0 0"/>
  </joint>

  <!-- FOUR WHEELS -->

  <xacro:wheel
    name="front_left"
    x="${wheel_x}"
    y="${wheel_y}"/>

  <xacro:wheel
    name="front_right"
    x="${wheel_x}"
    y="${-wheel_y}"/>

  <xacro:wheel
    name="rear_left"
    x="${-wheel_x}"
    y="${wheel_y}"/>

  <xacro:wheel
    name="rear_right"
    x="${-wheel_x}"
    y="${-wheel_y}"/>

</robot>